{
  "description": "Register silent task activity and subagent lifecycle hints for one local Chronos Governor without reading transcripts or adding model context.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"$PLUGIN_ROOT/skills/chronos/scripts/hook-intake.ps1\"",
            "commandWindows": "$ProgressPreference='SilentlyContinue'; & (Join-Path $env:PLUGIN_ROOT 'skills/chronos/scripts/hook-intake.ps1')",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"$PLUGIN_ROOT/skills/chronos/scripts/hook-intake.ps1\"",
            "commandWindows": "$ProgressPreference='SilentlyContinue'; & (Join-Path $env:PLUGIN_ROOT 'skills/chronos/scripts/hook-intake.ps1')",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"$PLUGIN_ROOT/skills/chronos/scripts/hook-intake.ps1\"",
            "commandWindows": "$ProgressPreference='SilentlyContinue'; & (Join-Path $env:PLUGIN_ROOT 'skills/chronos/scripts/hook-intake.ps1')",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"$PLUGIN_ROOT/skills/chronos/scripts/hook-intake.ps1\"",
            "commandWindows": "$ProgressPreference='SilentlyContinue'; & (Join-Path $env:PLUGIN_ROOT 'skills/chronos/scripts/hook-intake.ps1')",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"$PLUGIN_ROOT/skills/chronos/scripts/hook-intake.ps1\"",
            "commandWindows": "$ProgressPreference='SilentlyContinue'; & (Join-Path $env:PLUGIN_ROOT 'skills/chronos/scripts/hook-intake.ps1')",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
